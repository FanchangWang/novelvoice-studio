# 本地覆盖示例：复制为 .env（已被 git 忽略），不要提交真实路径或密钥。
# 优先级：进程环境变量 > .env > config/config.yaml > 默认值。
# 修改配置后需重启服务。

# --- 应用 ---
NOVELVOICE_APP__HOST=127.0.0.1
NOVELVOICE_APP__PORT=8765
# 留空 = %USERPROFILE%\Documents\NovelVoiceStudio
# NOVELVOICE_APP__DATA_DIR=D:\NovelVoiceData
# NOVELVOICE_APP__LOG_LEVEL=DEBUG

# 使用自定义 YAML 配置（默认 config/config.yaml）
# NOVELVOICE_CONFIG=D:\config\novelvoice.yaml

# --- Provider ---
# mock: 不加载模型，返回确定性结果（界面显示“模拟模式”）
# real: LLM 使用本机 Ollama；语音使用本机 8766/8767 Worker
NOVELVOICE_PROVIDERS__MODE=mock

# --- Ollama（阶段 2）---
# 模型清单、ModelScope 链接与目录约定见 docs/MODELS.md。
# Ollama 模型默认放在 %USERPROFILE%\.ollama\models，本项目不设置 OLLAMA_MODELS。
# NOVELVOICE_LLM__BASE_URL=http://127.0.0.1:11434
# NOVELVOICE_LLM__MODEL=modelscope.cn/unsloth/Qwen3.5-4B-GGUF:latest
# POC 实测必须关闭 thinking，否则 content 为空
# NOVELVOICE_LLM__ENABLE_THINKING=false
# NOVELVOICE_LLM__TEMPERATURE=0.2
# JSON 校验失败后的修复重试次数
# NOVELVOICE_LLM__JSON_RETRIES=2

# --- 声音设计 Worker（阶段 3，Qwen3-TTS VoiceDesign）---
# Worker 不会由应用自动启动：先运行 scripts/start_workers.ps1。
# 只接受 127.0.0.1 / localhost / ::1；填写其他地址会拒绝启动。
# NOVELVOICE_VOICE_DESIGN__WORKER_URL=http://127.0.0.1:8766
# NOVELVOICE_VOICE_DESIGN__MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# NOVELVOICE_VOICE_DESIGN__TIMEOUT_SECONDS=180
# NOVELVOICE_VOICE_DESIGN__CANDIDATES=3
# 列表使用 JSON；不足候选数时循环使用 seed
# NOVELVOICE_VOICE_DESIGN__SEEDS=[42,123,2026]
# NOVELVOICE_VOICE_DESIGN__REFERENCE_TEXT=雨停以后，街上的灯一盏一盏亮起来。
# NOVELVOICE_VOICE_DESIGN__NARRATOR_DESCRIPTION=成年男性，中音偏明亮，温和清晰，语感自然。

# --- 语音合成 Worker（阶段 3，CosyVoice3 VC）---
# NOVELVOICE_TTS__WORKER_URL=http://127.0.0.1:8767
# NOVELVOICE_TTS__MODEL_ID=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
# NOVELVOICE_TTS__TIMEOUT_SECONDS=240
# NOVELVOICE_TTS__DEFAULT_SEED=42
# NOVELVOICE_TTS__DEFAULT_SPEED=1.0
# 超过上限的片段会要求先拆分，不静默截断
# NOVELVOICE_TTS__MAX_TEXT_CHARS=1200
# 参考音在绑定时先去齿；阶段 3C 定稿参数如下
# NOVELVOICE_TTS__REFERENCE_DEESS__ENABLED=true
# NOVELVOICE_TTS__REFERENCE_DEESS__BAND_LOW=4000
# NOVELVOICE_TTS__REFERENCE_DEESS__BAND_HIGH=10000
# NOVELVOICE_TTS__REFERENCE_DEESS__THRESHOLD_RATIO=0.24
# NOVELVOICE_TTS__REFERENCE_DEESS__FULL_RATIO=0.62
# NOVELVOICE_TTS__REFERENCE_DEESS__MAX_REDUCTION_DB=5.0

# --- 分析 ---
# 单章超长会拒绝分析并提示拆分，避免静默截断
# NOVELVOICE_ANALYSIS__MAX_CHAPTER_CHARS=6000
# NOVELVOICE_ANALYSIS__SPEAKER_CONFIDENCE_THRESHOLD=0.6
# NOVELVOICE_ANALYSIS__EMOTION_CONFIDENCE_THRESHOLD=0.5
# NOVELVOICE_ANALYSIS__ALIAS_CONFIDENCE_THRESHOLD=0.7

# --- 本机停机控制 ---
# 由 scripts/server_control.py 在启动时随机生成并只注入子进程；
# 不要手工固定此值，也不要把生成值写入仓库。
# NOVELVOICE_CONTROL_TOKEN=