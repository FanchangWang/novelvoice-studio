# Normalize all text files to LF in the repository and in Windows checkouts.
# This repository is local-first, but Git history should be deterministic
# across Windows, Linux and macOS contributors.
* text=auto eol=lf

# Windows launchers need CRLF; PowerShell scripts stay LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Text formats that benefit from an explicit LF rule.
*.lock text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.mako text eol=lf

